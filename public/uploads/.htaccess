# ---------------------------------------------------------------
#  Folderul cu fisiere incarcate de utilizatori:
#  aici NU se executa niciodata cod, doar se servesc imagini.
# ---------------------------------------------------------------
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .phar
RemoveType .php .phtml .php3 .php4 .php5 .phar

<FilesMatch "\.(?i:php\d*|phtml|phar|cgi|pl|py|sh|js|html?|svg)$">
    Require all denied
</FilesMatch>
