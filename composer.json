{
    "name": "nxrby12/penita",
    "description": "Platforma de self-publishing cu sectiunea Blind Date with a Book",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "stripe/stripe-php": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
